: main
    hires
    clear

: reset_framebuffer
    i := bitstream_start
    load v2
    v8 := v0
    v9 := v1
    v4 := 0x00
    v5 := 0x00
    v0 := 0x00
    vC := 0x00

: clear_framebuffer
    i := frame_buffer
    i += vC
    save v0
    vC += 0x01
    if vC != 0x20 then
        jump clear_framebuffer

: check_end_of_stream
    i := end_of_stream
    load v2
    if v8 != v0 then
        jump decode_frame
    if v9 != v1 then
        jump decode_frame
    jump reset_framebuffer

: decode_frame
    vC := 0x00
    vD := 0x20

: decode_symbol_loop
    :call decode_symbol
    v0 := v3
    v0 += v3
    i := symbol_table
    i += v0
    load v1

: repeat_byte_loop
    i := frame_buffer
    i += vC
    save v0
    vC += 0x01
    vD += 0xFF
    v1 += 0xFF
    if v1 != 0x00 then
        jump repeat_byte_loop
    if vD != 0x00 then
        jump decode_symbol_loop
    clear
    i := frame_buffer
    v0 := 0x38
    v1 := 0x18
    sprite v0 v1 0x0
    vA := 0x01
    delay := vA

: wait_vsync
    v2 := delay
    if v2 == 0x00 then
        jump next_frame
    jump wait_vsync

: next_frame
    jump check_end_of_stream

: decode_symbol
    v3 := 0x00

: tree_walk
    v0 := v3
    v0 += v3
    v0 += v3
    i := huffman_tree
    i += v0
    load v2
    if v2 == 0xFF then
        jump branch_left
    v3 := v2
    return

: branch_left
    v6 := v0
    v7 := v1
    :call read_bit
    if vF == 0x01 then
        jump branch_right
    v3 := v6
    jump tree_walk

: branch_right
    v3 := v7
    jump tree_walk

: read_bit
    if v5 == 0x00 then
        :call refill_bit_buffer
    v4 <<= v4
    v5 += 0xFF
    return

: refill_bit_buffer
        if v8 != 0xB0 then
            jump load_next_byte
        v4 := 0x00
        v5 := 0x08
        return

: load_next_byte
    i := bitstream_ptr
    v0 := v8
    v1 := v9
    save v1

: bitstream_ptr
    0x00 0x00
    load v0
    v4 := v0
    v5 := 0x08
    v0 := 0x01
    v9 += v0
    v8 += vF
    return

: bitstream_start
    0xA3 0x5B 0x00 0x00

: end_of_stream
    0xAF 0x56 0x00 0x00

: frame_buffer
    0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
    0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
    0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
    0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00

: symbol_table
    0x00 0x01 0xFF 0x01 0x03 0x01 0x01 0x01
    0xC0 0x01 0xFC 0x01 0x1F 0x01 0x80 0x01
    0xF0 0x01 0xE0 0x01 0x07 0x01 0x3F 0x01
    0x00 0x04 0x00 0x10 0x00 0x20

