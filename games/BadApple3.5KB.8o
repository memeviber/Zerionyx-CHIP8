: main
    hires
    clear
    i := video_header
    load v2
    v8 := v0
    v9 := v1
    v4 := 0x00
    v5 := 0x00

: frame_loop
    vC := 0x00
    vD := 0x20

: decode_byte_loop
    :call decode_byte
    i := frame_buffer
    i += vC
    save v0
    vC += 0x01
    vD += 0xFF
    if vD == 0x00 then
        jump render_frame
    jump decode_byte_loop

: render_frame
    clear
    i := frame_buffer
    v0 := 0x38
    v1 := 0x18
    sprite v0 v1 0x0
    vA := 0x01
    delay := vA

: wait_vsync
    v2 := delay
    if v2 == 0x00 then
        jump next_frame
    jump wait_vsync

: next_frame
    jump frame_loop

: decode_byte
    :call decode_nibble
    vA := v3
    vA <<= vA
    vA <<= vA
    vA <<= vA
    vA <<= vA
    :call decode_nibble
    v0 := vA
    v0 |= v3
    return

: decode_nibble
    v3 := 0x00

: tree_walk
    v0 := v3
    v0 += v3
    v0 += v3
    i := huffman_tree
    i += v0
    load v2
    if v2 == 0xFF then
        jump branch_left
    v3 := v2
    return

: branch_left
    v6 := v0
    v7 := v1
    :call read_bit
    if vF == 0x01 then
        jump branch_right
    v3 := v6
    jump tree_walk

: branch_right
    v3 := v7
    jump tree_walk

: read_bit
    if v5 == 0x00 then
        :call refill_bit_buffer
    v4 <<= v4
    v5 += 0xFF
    return

: refill_bit_buffer
    i := bitstream_ptr
    v0 := v8
    v1 := v9
    save v1

: bitstream_ptr
    0x00 0x00
    load v0
    v4 := v0
    v5 := 0x08
    v0 := 0x01
    v9 += v0
    v8 += vF
    return

: video_header

    0xA3 0x1D 0x00 0x00

: frame_buffer

    0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
    0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
    0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
    0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00

